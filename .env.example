# Copy to .env.local. Use unique, long values for all three secrets.
SITE_PASSWORD=change-this-to-a-long-unique-visitor-password
ADMIN_PASSWORD=change-this-to-a-different-long-unique-admin-password
SESSION_SECRET=replace-with-at-least-32-random-characters

# Project settings from Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
